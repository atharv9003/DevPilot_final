# ==========================================
# DevPilot Environment Configuration Template
# ==========================================

# 1. Core LLM API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 2. Model Context Protocol (MCP) Search Key
TAVILY_API_KEY=""

# 3. Blackboard Settings ('memory' or 'redis')
BLACKBOARD_BACKEND="memory"
REDIS_HOST="localhost"
REDIS_PORT=6379

# 4. Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# 5. Sandbox Configuration
DOCKER_IMAGE="devpilot-sandbox:latest"
SANDBOX_TIMEOUT_SECONDS=30

# 6. A2A HTTP Authentication for non-loopback agents
A2A_TOKEN=""

# 7. Internal Docker sandbox broker authentication (use a unique random value)
SANDBOX_BROKER_TOKEN=""

